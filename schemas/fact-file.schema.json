{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact-file.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "facts"],
  "properties": {
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "property",
          "value",
          "status",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "status": {
            "enum": [
              "verified",
              "candidate",
              "conflicting",
              "deprecated"
            ]
          },
          "valid_from": {
            "type": ["string", "null"],
            "format": "date"
          },
          "valid_to": {
            "type": ["string", "null"],
            "format": "date"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "string"
          },
          "discovered_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "reviewed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "reviewed_by": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
